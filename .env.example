# ─── Supabase (Frontend — browser-safe, anon key) ────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Supabase (Backend — service role key, NEVER expose to browser) ───────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_from_meta
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta
WHATSAPP_VERIFY_TOKEN=my_verify_token
META_APP_SECRET=your_meta_app_secret_for_hmac_validation

# ─── AI (Gemini) ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Website ──────────────────────────────────────────────────────────────────
WEBSITE_BASE_URL=https://your-domain.vercel.app

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
